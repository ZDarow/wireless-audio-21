# GitAttributes — единые окончания строк и атрибуты файлов

* text=auto eol=lf

*.cpp text diff=cpp
*.h text diff=cpp
*.cxx text diff=cpp
*.cc text diff=cpp

*.yml text diff=yaml
*.yaml text diff=yaml

*.md text
*.txt text

*.json text

*.ino text diff=cpp

# Бинарники и артефакты сборки — не diff'ить
*.bin binary
*.elf binary
*.hex binary
*.map binary

# PlatformIO
.pio*/** binary
.platformio/** binary
