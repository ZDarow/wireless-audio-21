# HTTPD: увеличить лимит URI handlers (по умолчанию 8, зарегистрировано ~25)
CONFIG_HTTPD_MAX_URI_HANDLERS=30

# PSRAM: включить поддержку (ESP32-S3, OPI PSRAM 8 МБ)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE=OPI
CONFIG_SPIRAM_SPEED_80M=y

# LWIP_MDNS_RESPONDER не является Kconfig опцией в v5.3.1
# mDNS реализован через отдельный компонент mdns_raw

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# NAPT для APSTA режима репитера (ТЗ §6.1, F21)
CONFIG_LWIP_IP_FORWARD=y
CONFIG_LWIP_IPV4_NAPT=y

# Увеличить стек задачи main для Wi-Fi сканирования (wifi_ap_record_t[] ~5 КБ)
CONFIG_MAIN_TASK_STACK_SIZE=16384
