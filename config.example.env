# Wireless Audio 2.1 — пример конфигурации окружения
# Скопируйте в config.env и отредактируйте под свою сеть/железо.
# Используется скриптом scripts/generate_config.py для генерации
# firmware/common/generated/generated_config.h

# Роль узла: MASTER или SATELLITE
AUDIO_NODE_ROLE=MASTER

# Источник аудио для мастера: A2DP или WIFI
# (ESP32-S3 не поддерживает A2DP — для S3 только WIFI)
AUDIO_SOURCE_MODE=WIFI

# Транспорт до сателлитов: ESPNOW или UDP
AUDIO_TRANSPORT_MODE=ESPNOW

# Режим Wi-Fi мастера:
#   AP_DIRECT — мастер создаёт точку доступа, смартфон подключается напрямую
#               (интернета у смартфона НЕТ, нужен ручной режим мобильных данных).
#   STA       — мастер подключается к домашней сети как клиент.
#   APSTA     — репитер: мастер подключается к домашней сети и РАЗДАЁТ её
#               через свою точку доступа (смартфон получает интернет через мастера).
#               SSID/пароль ниже — домашняя сеть; AP мастера — AUDIO_WIFI_AP_*.
AUDIO_WIFI_MODE=APSTA
AUDIO_WIFI_AP_SSID=Audio21-Master
AUDIO_WIFI_AP_PASSWORD=audio21master
AUDIO_WIFI_SSID=MyHomeNetwork
AUDIO_WIFI_PASSWORD=MyHomePassword
AUDIO_HOSTNAME=audio-master

# UDP-порт приёма аудио от смартфона (ТЗ §6.3: 5004)
AUDIO_UDP_PORT=5004

# Канал Wi-Fi/ESP-NOW для связи мастер-сателлиты (1..13). AP мастера и
# сателлиты должны быть на одном канале; в APSTA канал мастер берёт от
# домашней сети, поэтому задаётся тот же номер, что у роутера.
AUDIO_ESPNOW_CHANNEL=6

# MAC-адреса сателлитов (для ESP-NOW и UDP unicast)
AUDIO_LEFT_SAT_MAC=AA:BB:CC:DD:EE:01
AUDIO_RIGHT_SAT_MAC=AA:BB:CC:DD:EE:02

# Формат PCM (по умолчанию для смартфона — 48 кГц)
AUDIO_SAMPLE_RATE=48000
AUDIO_BITS_PER_SAMPLE=16
AUDIO_CHANNELS=2

# Кроссовер и задержки (мс)
AUDIO_CROSSOVER_HZ=90
AUDIO_DELAY_LEFT_MS=0
AUDIO_DELAY_RIGHT_MS=0
AUDIO_DELAY_SUB_MS=0

# GPIO I2S (мастер: выход на сабвуфер; сателлит: выход на колонку)
# ESP32-S3: GPIO22-25 невалидны (внутренний SPI-флеш) — используем 4/5/6.
AUDIO_I2S_BCK=4
AUDIO_I2S_WS=5
AUDIO_I2S_DATA_OUT=6

# OLED (мастер). SCL на 18: валидный пин S3, не конфликтует с I2S.
AUDIO_OLED_SDA=21
AUDIO_OLED_SCL=18

# Энкодер (мастер)
AUDIO_ENC_A=32
AUDIO_ENC_B=33
AUDIO_ENC_BTN=34
