# Wireless Audio 2.1 — пример конфигурации окружения
# Скопируйте в config.env и отредактируйте под свою сеть/железо.
# Используется скриптом scripts/generate_config.py для генерации
# firmware/common/generated/generated_config.h

# Роль узла: MASTER или SATELLITE
AUDIO_NODE_ROLE=MASTER

# Источник аудио для мастера: A2DP или WIFI
# (ESP32-S3 не поддерживает A2DP — для S3 только WIFI)
AUDIO_SOURCE_MODE=WIFI

# Транспорт до сателлитов: ESPNOW или UDP
AUDIO_TRANSPORT_MODE=ESPNOW

# Режим Wi-Fi мастера: AP_DIRECT (мастер создаёт точку доступа) или STA
AUDIO_WIFI_MODE=AP_DIRECT

# Wi-Fi: в режиме AP_DIRECT это SSID/пароль точки доступа мастера,
# в режиме STA — домашней сети. Фиксированный канал 6, 20 МГц.
AUDIO_WIFI_SSID=Audio21-Master
AUDIO_WIFI_PASSWORD=audio21master
AUDIO_HOSTNAME=audio-master

# UDP-порт приёма аудио от смартфона (ТЗ §6.3: 5004)
AUDIO_UDP_PORT=5004

# MAC-адреса сателлитов (для ESP-NOW и UDP unicast)
AUDIO_LEFT_SAT_MAC=AA:BB:CC:DD:EE:01
AUDIO_RIGHT_SAT_MAC=AA:BB:CC:DD:EE:02

# Формат PCM (по умолчанию для смартфона — 48 кГц)
AUDIO_SAMPLE_RATE=48000
AUDIO_BITS_PER_SAMPLE=16
AUDIO_CHANNELS=2

# Кроссовер и задержки (мс)
AUDIO_CROSSOVER_HZ=90
AUDIO_DELAY_LEFT_MS=0
AUDIO_DELAY_RIGHT_MS=0
AUDIO_DELAY_SUB_MS=0

# GPIO I2S (мастер: выход на сабвуфер; сателлит: выход на колонку)
AUDIO_I2S_BCK=26
AUDIO_I2S_WS=25
AUDIO_I2S_DATA_OUT=22

# OLED (мастер)
AUDIO_OLED_SDA=21
AUDIO_OLED_SCL=22

# Энкодер (мастер)
AUDIO_ENC_A=32
AUDIO_ENC_B=33
AUDIO_ENC_BTN=34
