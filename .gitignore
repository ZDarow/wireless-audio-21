# Compiled/Binary files
*.o
*.obj
*.exe
*.dll
*.so
*.a
*.out

# Генерируемые файлы конфигурации (из config.env)
firmware/common/generated/
config.env

# Python
__pycache__/
*.py[cod]

# Сборка и тестовые бинарники
test/*_bin*
test/*.d

# PlatformIO / IDE артефакты (не коммитится)
.pio/
.pio-core-master/
.vscode/

# ESP-IDF build артефакты (не коммитится)
firmware/master_s3_idf/build/
firmware/satellite_s3_idf_left/build/
firmware/satellite_s3_idf_right/build/

# Сгенерированный sdkconfig (не коммитится, только sdkconfig.defaults)
firmware/*/sdkconfig
firmware/*/*/sdkconfig

# Системное
.DS_Store
*.swp

# Локальные артефакты инструментов и агентов
.kilo/
.playwright-mcp/

# Мусорные артефакты в корне
firebase-debug.log
*.firebaserc
Новый текстовый документ*.txt
*.orig

# Логи сборки PlatformIO
build_*.log
*.log

# Временные файлы агентов
QWEN.md

# Сторонние библиотеки (не часть проекта)
gpio_viewer/

# Экспортированные документы (не исходный код)
docs/*.html
